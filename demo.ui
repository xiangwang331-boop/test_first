}


QRadioButton::unchecked{color:rgb(255, 0, 0);}
QRadioButton::checked{color:rgb(0, 255, 0);}
QRadioButton::indicator:checked {
    border-radius: 10px; /* 圆角效果 */
    background-color:rgb(0,255,0);
}

