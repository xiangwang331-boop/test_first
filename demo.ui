}


QComboBox {
    background-color: #3498db; /* 按钮背景色 */
    color: white; /* 按钮文字颜色 */
    border: 2px solid #2980b9; /* 边框颜色和宽度 */
    border-radius: 10px; /* 圆角效果 */
    font-size: 30px; /* 字体大小 */
    padding: 5px; /* 内边距 */
    text-align: center;    /* 水平居中 */
    vertical-align: middle; /* 垂直居中 */   
}
QComboBox:hover { 
color: red;
font-size: 29px; /* 字体大小 */
}
QPushButton[flat=&quot;false&quot;]{
    background-color: #3498db; /* 按钮背景色 */
    color: white; /* 按钮文字颜色 */
    border: 2px solid #2980b9; /* 边框颜色和宽度 */
    border-radius: 10px; /* 圆角效果 */
    font-size: 30px; /* 字体大小 */
    padding: 5px; /* 内边距 */
    text-align: center;    /* 水平居中 */
    vertical-align: middle; /* 垂直居中 */           
}
QPushButton[flat=&quot;false&quot;]:hover {
    color: red; /* 鼠标悬停时的文字颜色 */
    font-size: 29px; /* 鼠标悬停时放大字体 */
}
#select_model_Button{
    background-color: #3498db; /* 按钮背景色 */
    color: white; /* 按钮文字颜色 */
    border: 2px solid #2980b9; /* 边框颜色和宽度 */
    border-radius: 10px; /* 圆角效果 */
