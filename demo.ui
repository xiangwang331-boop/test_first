    padding: 5px; /* 内边距 */
    text-align: center;    /* 水平居中 */
    vertical-align: middle; /* 垂直居中 */  
}
#select_model_Button:hover{
    color: red; /* 鼠标悬停时的文字颜色 */
    font-size: 26px; /* 鼠标悬停时放大字体 */
}


QPushButton:hover { 
color: red;
font-size: 29px; /* 字体大小 */
}

QPushButton{
    background-color:rgb(255, 255, 255); /* 按钮背景色 */
    color:rgb(0, 0, 0); /* 按钮文字颜色 */
    border: 2px solid rgb(0, 0, 0); /* 边框颜色和宽度 */
    border-radius: 0px; /* 圆角效果 */
    font-size: 30px; /* 字体大小 */
    padding: 5px; /* 内边距 */
    text-align: left; /* 文字左对齐 */
    padding-left: 10px; /* 可选：设置文字左侧的间距 */
   
}

QLabel[labelhead=false]{
